<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Gorilla Tag half of GorillaCraft (BepInEx 5 plugin).
    Build: dotnet build -c Release            (GamePath defaults to the usual Steam location on Linux)
           dotnet build -c Release -p:GamePath="C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag"
    Add -p:Deploy=true to copy the dll into BepInEx/plugins.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GorillaCraft</AssemblyName>
    <RootNamespace>GorillaCraft</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.10.5</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GamePath Condition="'$(GamePath)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Gorilla Tag</GamePath>
    <Managed>$(GamePath)/Gorilla Tag_Data/Managed</Managed>
    <BepInEx>$(GamePath)/BepInEx</BepInEx>
    <!-- Jars the plugin installs into Prism Launcher (embedded in the dll). -->
    <ModJar Condition="'$(ModJar)' == ''">$(MSBuildThisFileDirectory)../fabric/build/libs/gorillacraft-fabric-$(Version)+26.3.jar</ModJar>
    <GradleHome Condition="'$(GradleHome)' == '' and '$(OS)' == 'Windows_NT'">$(USERPROFILE)/.gradle</GradleHome>
    <GradleHome Condition="'$(GradleHome)' == ''">$(HOME)/.gradle</GradleHome>
    <FabricApiVersion>0.161.0+26.3</FabricApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <FabricApiJar Include="$(FabricApiJar)" Condition="'$(FabricApiJar)' != ''" />
    <FabricApiJar Include="$(GradleHome)/caches/modules-2/files-2.1/net.fabricmc.fabric-api/fabric-api/$(FabricApiVersion)/**/fabric-api-$(FabricApiVersion).jar" Condition="'$(FabricApiJar)' == ''" />
    <EmbeddedResource Include="$(ModJar)" LogicalName="jar/%(Filename)%(Extension)" />
    <EmbeddedResource Include="@(FabricApiJar)" LogicalName="jar/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckEmbeddedJars" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ModJar)')" Text="Build the Minecraft mod first (cd fabric; gradlew build): $(ModJar) is missing." />
    <Error Condition="'@(FabricApiJar)' == ''" Text="fabric-api-$(FabricApiVersion).jar not found. Build the Minecraft mod once (it downloads it) or pass -p:FabricApiJar=path." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInEx)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInEx)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.XR.Management"><HintPath>$(Managed)/Unity.XR.Management.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Managed)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(Managed)/UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInEx)/plugins/GorillaCraft" />
    <Message Importance="high" Text="Deployed to $(BepInEx)/plugins/GorillaCraft" />
  </Target>
</Project>
