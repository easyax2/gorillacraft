{
	"schemaVersion": 1,
	"id": "gorillacraft",
	"version": "${version}",
	"name": "GorillaCraft",
	"description": "Minecraft half of GorillaCraft: streams the world around you to Gorilla Tag and plays the hand interactions Gorilla Tag sends back.",
	"authors": ["tom"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.gorillacraft.GorillaCraft"],
		"client": ["dev.gorillacraft.client.GorillaCraftClient"]
	},
	"mixins": ["gorillacraft.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
